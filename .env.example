# Notification toggles (true/false)
ENABLE_TELEGRAM=false
ENABLE_EMAIL=false

# Telegram Bot (create via @BotFather, get chat_id via @userinfobot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Gmail SMTP (use an App Password, not your regular password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_RECIPIENT=your.email@gmail.com

# Gmail inbox scanner for application confirmations
APPLICATION_EMAIL_USERNAME=sakshijs1211@gmail.com
APPLICATION_EMAIL_APP_PASSWORD=your_gmail_app_password
APPLICATION_IMAP_HOST=imap.gmail.com
APPLICATION_IMAP_MAILBOX=INBOX

# Optional LLM extraction layer for cleaner application rows
APPLICATION_LLM_ENABLED=false
APPLICATION_LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=your_gemini_api_key
